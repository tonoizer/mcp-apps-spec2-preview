{
  "name": "@module-federation/mcp-apps",
  "version": "0.1.0-preview",
  "type": "module",
  "description": "MCP Apps Server for rendering Module Federation components as interactive UIs in AI Agents",
  "license": "MIT",
  "author": "fengdanping@bytedance.com",
  "keywords": [
    "mcp",
    "mcp-apps",
    "mcp-server",
    "module-federation",
    "micro-frontend",
    "remote-components",
    "dynamic-import"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/module-federation/mcp-apps.git"
  },
  "homepage": "https://github.com/module-federation/mcp-apps#readme",
  "bugs": {
    "url": "https://github.com/module-federation/mcp-apps/issues"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "mf-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "skill",
    "mcp_apps.schema.json",
    "mcp_apps.example.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./transports": {
      "types": "./dist/transports.d.ts",
      "default": "./dist/transports.js"
    }
  },
  "typesVersions": {
    "*": {
      "renderer": [
        "./dist/renderer.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@module-federation/enhanced": "^2.2.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.0.0",
    "zod": "^4.2.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@rsbuild/core": "^1.4.0",
    "@rsbuild/plugin-react": "^1.4.0",
    "@changesets/cli": "^2.27.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist/ && npm run build:ui && tsc && chmod +x dist/index.js && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "build:check": "tsc --noEmit && npm run build:ui && tsc && chmod +x dist/index.js",
    "build:ui": "node ui/build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js --config examples/basic/mcp_apps.json",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version:bump": "changeset version",
    "release": "changeset publish",
    "demo:build": "rsbuild build -c examples/demo/rsbuild.remote.config.mjs && rsbuild build -c examples/demo/rsbuild.host.config.mjs",
    "demo": "npm run demo:build && node examples/demo/server.mjs",
    "demo:stdio": "node examples/demo/server.mjs --stdio",
    "demo:screenshot": "node examples/demo/screenshot.mjs",
    "verify": "bash verify/run-all.sh"
  }
}
